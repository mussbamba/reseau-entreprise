# Base de données PostgreSQL (Neon gratuit : https://neon.tech)
# DATABASE_URL = chaîne « Pooled connection », DIRECT_URL = chaîne directe (sans « -pooler »)
DATABASE_URL="postgresql://utilisateur:motdepasse@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://utilisateur:motdepasse@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# URL publique du site (utilisée pour les liens dans les courriels et Stripe)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Mot de passe de l'espace admin (/admin) et secret de signature du cookie
ADMIN_PASSWORD="changez-moi"
AUTH_SECRET="une-longue-chaine-aleatoire"

# Stripe : laissez vide pour le MODE DÉMO (paiement simulé)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Courriels via Resend : laissez vide pour afficher les courriels dans la console
RESEND_API_KEY=""
EMAIL_FROM="Saveurs d'Afrique <commandes@exemple.ca>"
ADMIN_EMAIL=""

# Taxes : "false" tant que vous êtes petit fournisseur non inscrit (< 30 000 $/an)
TAXES_ENABLED="false"
